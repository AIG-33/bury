# Fastlane Appfile — PlayTennis.by
#
# Shared identifiers for the iOS (deliver) and Android (supply) lanes.
# NO SECRETS live here. App Store Connect API keys, Google Play service-account
# JSON, team ids etc. are passed at runtime via environment variables — see
# fastlane/Fastfile and docs/STORE_SUBMISSION.md.

# --- iOS / App Store Connect ---
app_identifier("by.playtennis.app")

# Apple ID used for App Store Connect (only needed for password-based auth;
# prefer the App Store Connect API key flow — see Fastfile). Leave as ENV.
apple_id(ENV["FASTLANE_APPLE_ID"]) # e.g. "you@example.com"

# Developer Portal team id (10-char) and App Store Connect team id.
team_id(ENV["FASTLANE_TEAM_ID"])           # Apple Developer Portal team
itc_team_id(ENV["FASTLANE_ITC_TEAM_ID"])   # App Store Connect team (optional)

# --- Android / Google Play ---
# Package name for the `supply` lane (Google Play).
for_platform :android do
  package_name("by.playtennis.app")
end
