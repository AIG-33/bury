# --- Site ---
# Local dev:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production (canonical — always use www):
# NEXT_PUBLIC_SITE_URL=https://www.playtennis.by
# Search-console verification (optional, shown in <head> when set)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Social sign-in (Google + Apple) — see docs/MOBILE.md "OAuth setup" ---
# WEB uses supabase.auth.signInWithOAuth (providers configured in the Supabase
# dashboard only — no client-side env needed on web). NATIVE (Capacitor) uses
# the id-token flow via @capgo/capacitor-social-login and needs these public
# client IDs baked into the hosted build:
#   Google "Web application" OAuth client id (also used as the iOS token audience)
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=
#   Google "iOS" OAuth client id (the app requests tokens with this on iOS)
NEXT_PUBLIC_GOOGLE_IOS_CLIENT_ID=
#   Apple "Services ID" (used for Sign in with Apple on ANDROID only)
NEXT_PUBLIC_APPLE_SERVICES_ID=
#   Apple redirect URL for Android (server callback, e.g. your Supabase auth
#   callback: https://<project-ref>.supabase.co/auth/v1/callback)
NEXT_PUBLIC_APPLE_REDIRECT_URL=

# Local `supabase start` only — provider credentials for supabase/config.toml.
# In production these live in the Supabase dashboard (Auth → Providers).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

# --- Email (Resend) — primary channel for automated notifications ---
# Optional in dev (falls back to console.log).
RESEND_API_KEY=
RESEND_FROM=PlayTennis.by <noreply@example.com>
# Svix signing secret for the Resend webhook (/api/resend-webhook), "whsec_..."
RESEND_WEBHOOK_SECRET=

# --- WhatsApp Business API (planned for Phase 2) ---
# WhatsApp is the primary contact channel in Belarus. Currently we only use
# wa.me click-to-chat links (no API needed). For automated notifications we'll
# wire Twilio or Meta Business Cloud API later — placeholders below for that.
WHATSAPP_PROVIDER=
WHATSAPP_API_TOKEN=
WHATSAPP_FROM_NUMBER=

# --- Telegram bot (optional secondary messenger) ---
# Disabled when empty. Used only for users who prefer Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Public bot handle WITHOUT the leading "@". Used by the "Connect Telegram"
# deep-link on /me/profile: https://t.me/<NEXT_PUBLIC_TELEGRAM_BOT_USERNAME>?start=<token>
# Also powers the floating Telegram widget + footer link (hidden when empty).
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Chat id that receives user feedback sent to the bot (your own chat with the
# bot — get it via https://t.me/userinfobot). Feedback is dropped when empty.
TELEGRAM_FEEDBACK_CHAT_ID=

# --- Cron (used by /api/cron) ---
CRON_SECRET=

# --- Observability — optional ---
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
